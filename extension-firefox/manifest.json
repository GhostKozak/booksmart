{
  "manifest_version": 3,
  "name": "BookSmart Companion",
  "version": "1.1.0",
  "description": "Serverless health checker and bidirectional browser bookmark sync for BookSmart.",
  "permissions": [
    "bookmarks",
    "tabs",
    "activeTab",
    "storage",
    "contextMenus",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BookSmart Companion"
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "booksmart-companion@booksmart.app",
      "strict_min_version": "109.0"
    }
  }
}
